rules_version = '2';
// 보안 규칙 (05-design 6장). 여기에 없는 경로는 모두 막힌다.
service cloud.firestore {
  match /databases/{database}/documents {
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }

    // USER: 본인만 읽고 쓴다. 만 14세 확인 없이는 만들 수 없다(R20). 삭제 중이면 쓰기 거부(R13).
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['display_name', 'age14_confirmed', 'deleting', 'created_at'])
        && validName(request.resource.data.display_name)
        && request.resource.data.age14_confirmed == true
        && request.resource.data.deleting == false
        && request.resource.data.created_at == request.time;
      allow update: if request.auth.uid == uid
        && resource.data.deleting == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name'])
        && validName(request.resource.data.display_name);
    }

    // 크루 (R14, R15): 같은 크루 멤버만 읽는다. 쓰기는 서버 함수만. 나가거나 내보내지면 바로 못 읽는다.
    function isMember(crewId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/crews/$(crewId)/members/$(request.auth.uid));
    }
    match /crews/{crewId} {
      allow read: if isMember(crewId);
      match /members/{memberId} {
        allow read: if isMember(crewId);
      }
    }
    // 내 크루 목록: collectionGroup('members') where uid == 내 uid
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // invites는 클라이언트가 읽지 않는다(previewInvite 함수로만)
  }
}
