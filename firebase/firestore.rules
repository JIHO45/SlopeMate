rules_version = '2';
// 보안 규칙 (05-design 6장). 여기에 없는 경로는 모두 막힌다.
service cloud.firestore {
  match /databases/{database}/documents {
    // USER: 본인만 읽는다. 만들기·바꾸기는 함수만(signUp: 금지어·만 14세·삭제 표시 확인, setDisplayName: 크루 이름도 함께).
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
    }

    // 크루 (R14, R15): 같은 크루 멤버만 읽는다. 쓰기는 서버 함수만. 나가거나 내보내지면 바로 못 읽는다.
    function isMember(crewId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/crews/$(crewId)/members/$(request.auth.uid));
    }
    match /crews/{crewId} {
      allow read: if isMember(crewId);
      match /members/{memberId} {
        allow read: if isMember(crewId);
      }
      // 차단 기록: 크루장만 읽는다(해제 화면). 크루원은 누가 내보내졌는지 보지 못한다.
      match /bans/{banId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/crews/$(crewId)).data.owner_uid == request.auth.uid;
      }
    }
    // 내 크루 목록: collectionGroup('members') where uid == 내 uid
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // 시즌 합계(R15): 본인만 읽는다(새로 설치했을 때 서버 합계 확인). 쓰기는 syncSummary 함수만.
    // 문서 ID("{uid}_{시즌}")로 소유자를 본다: 아직 없는 본인 문서도 조회할 수 있어야 첫 동기화가 된다.
    match /season_summaries/{id} {
      allow read: if request.auth != null && id.split('_')[0] == request.auth.uid;
    }
    // 신고(R16): 신고한 본인만 읽는다(처리 결과 알림). 쓰기는 reportName 함수와 처리 스크립트만.
    match /reports/{id} {
      allow read: if request.auth != null && resource.data.reporter_uid == request.auth.uid;
    }
    // invites는 클라이언트가 읽지 않는다(previewInvite 함수로만)
  }
}
